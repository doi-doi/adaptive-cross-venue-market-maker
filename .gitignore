# Python and local tooling
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
*.py[cod]
.coverage
htmlcov/

# macOS and IDE metadata
.DS_Store
.idea/
.vscode/
.fleet/

# Credentials and secrets: names and values stay out of Git.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials*
secrets*
api_keys*
*.secret

# Runtime telemetry, logs, and process markers
logs/
*.log
*.out
*.err
*.pid
*.lock
*.tmp
*.tmp.*
tmp/
temp/
runtime/

# SQLite and other local database variants, including sidecars
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite.*
*.db
*.db-*
*.db.*
*.duckdb
*.duckdb-*

# Raw market-data and telemetry payloads
**/raw/
**/telemetry/
data/raw/
**/*bbo*
**/*tick*
**/*orderbook_raw*
*.jsonl
*.ndjson
chunks/
**/chunks/
completed_raw/
**/completed_raw/
cache/
**/cache/
dashboard/cache/

# Generated reports are local evidence. Only compact, reviewed summaries are
# published under reports/published/.
reports/*
!reports/
!reports/published/
!reports/published/**
