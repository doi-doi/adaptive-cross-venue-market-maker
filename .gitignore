.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.py[cod]
.DS_Store

# Runtime telemetry and generated research artifacts stay local. They can
# contain large archives and run-specific operational data; source/config/docs
# remain versioned below.
logs/*
!logs/mainnet_shadow/
logs/mainnet_shadow/*
!logs/mainnet_shadow/.gitkeep

reports/*
!reports/mainnet_shadow/
reports/mainnet_shadow/*
!reports/mainnet_shadow/.gitkeep

!logs/multi_reference_shadow/
logs/multi_reference_shadow/*
!logs/multi_reference_shadow/.gitkeep
!reports/multi_reference_shadow/
reports/multi_reference_shadow/*
!reports/multi_reference_shadow/.gitkeep

*.sqlite
*.sqlite-shm
*.sqlite-wal
*.pid
*.tmp

# Never store credentials in this project.
.env
*.secret
*.key
*.pem
